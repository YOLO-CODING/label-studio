# ============================================
# ML Backend 生产环境配置
# 升级时直接替换 /opt/ml_backend/.env
# ============================================

# ============ Label Studio 互联（独立 compose 用宿主网桥 IP）============
# 注意：不能用 'localhost' 或 '127.0.0.1'，因为 ml-backend 是独立 compose 网络
# 通过 Docker 默认网桥（172.17.0.1）访问宿主上的 ai-platform nginx (8080 端口)
LABEL_STUDIO_HOST=http://172.17.0.1:8080

# Label Studio API Token（升级前必须填入）
# ⚠ 必须使用【旧版令牌 (Legacy Token)】，不能用个人令牌/JWT！
#    个人令牌是 JWT（token_type=refresh），ml-backend 用 DRF 'Authorization: Token' 鉴权只认旧版令牌，
#    用错会导致预标注下载图片报 401 Unauthorized（详见 deploy/TROUBLESHOOTING.md 问题 10）
# 获取方法：浏览器登录 LS → 右上角账户设置 → 「旧版令牌」 复制其值
# 备用方法：从生产 /opt/ml_backend/.env 复制 LABEL_STUDIO_API_KEY 的值到这里
# 不填会导致 ml-backend 无法回拉图片完成预标注
LABEL_STUDIO_API_KEY=

# ============ ML Backend 默认模型配置 ============
# 项目 label_config 中没有 model_path 时（如取消部署后），ml-backend 使用此默认模型
# 切换默认模型流程：
#   1. 把新模型文件放到 /data/hainan/mlbackend-models/
#   2. 修改下方变量为新文件名
#   3. cd /opt/ml_backend && docker compose restart
# 无需重新构建镜像
DEFAULT_MODEL_RECTANGLE_LABELS=ship-segment-best.pt
DEFAULT_MODEL_POLYGON_LABELS=ship-segment-best.pt
