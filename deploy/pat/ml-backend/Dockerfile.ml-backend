# Label Studio ML Backend - YOLO 推理服务
# CPU 版本（无 GPU 依赖），使用国内镜像源
# 适用于 x86_64 Linux 服务器

FROM m.daocloud.io/docker.io/python:3.10-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# 替换 apt 源为阿里云
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources

# 系统依赖
RUN --mount=type=cache,target="/var/cache/apt",sharing=locked \
    --mount=type=cache,target="/var/lib/apt/lists",sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git wget curl \
        build-essential \
        ffmpeg libsm6 libxext6 libffi-dev \
        libgl1-mesa-glx libglib2.0-0 \
        libfreetype6-dev \
    && apt-get autoremove -y

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_CACHE_DIR=/.cache \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    PIP_DEFAULT_TIMEOUT=120 \
    PORT=9090 \
    WORKERS=2 \
    THREADS=4 \
    PYTHONPATH=/app

RUN pip install --upgrade pip setuptools wheel

# 安装 PyTorch CPU 版本（指定 CPU index，避免拉取 GPU 包 ~2GB+）
RUN --mount=type=cache,target=${PIP_CACHE_DIR},sharing=locked \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.2.2+cpu torchvision==0.17.2+cpu

# 复制并安装 label-studio-ml-backend 源码（本地仓库）
COPY ml-backend-src /tmp/ml-backend-src
RUN --mount=type=cache,target=${PIP_CACHE_DIR},sharing=locked \
    cd /tmp/ml-backend-src && \
    pip install --no-deps -e . && \
    pip install \
        gunicorn==23.0.0 \
        label-studio-sdk==2.0.4 \
        "flask>2.3" \
        "colorama~=0.4" \
        "requests~=2.31" \
        "semver~=3.0.2"

# 安装 YOLO 业务依赖
COPY requirements.txt .
RUN --mount=type=cache,target=${PIP_CACHE_DIR},sharing=locked \
    pip install -r requirements.txt

# 复制 YOLO 应用代码（包含 ship-segment 业务逻辑）
COPY . ./

# 创建 models 目录并复制默认模型（ShipPolygonLabelsModel 启动时会预加载）
# 默认模型文件由 build.sh 在构建上下文中准备
RUN mkdir -p /app/models /data/models
COPY models/ship-segment-best.pt /app/models/ship-segment-best.pt
COPY models/ship-segment-best.pt /data/models/ship-segment-best.pt

# 确保 start.sh 可执行
RUN chmod +x /app/start.sh

EXPOSE 9090

CMD ["/app/start.sh"]
