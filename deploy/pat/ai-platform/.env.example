# ============================================
# Label Studio AI Platform 生产环境配置（模板）
# 部署时：cp .env.example .env，然后填入真实密钥
# 升级时直接替换 /opt/ai-platform/.env
# ============================================

# Label Studio 主机地址（外部访问）
LABEL_STUDIO_HOST=http://172.16.155.241:8080
COMPOSE_PROFILES=minio,prod

# ============ PostgreSQL 数据库 ============
POSTGRES_DATABASE=label-platform
POSTGRES_USER=admin
POSTGRES_PASSWORD=<生产密码>
POSTGRES_PORT=5432

# ============ MinIO 对象存储 ============
MINIO_ENDPOINT=http://minio:9000
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-05-21T01-59-54Z
MINIO_USER=admin
MINIO_PASSWORD=<生产密码>
MINIO_BUCKET=labelstudio
MINIO_ACCESS_KEY=<生产AccessKey>
MINIO_SECRET_KEY=<生产SecretKey>

# ============ MinIO Storage（Django 使用 MinIO 存储上传文件）============
MINIO_STORAGE_ENDPOINT=http://minio:9000
MINIO_STORAGE_BUCKET_NAME=labelstudio
MINIO_STORAGE_ACCESS_KEY=<生产AccessKey>
MINIO_STORAGE_SECRET_KEY=<生产SecretKey>

# ============ 数据卷路径 ============
MYSQL_DATA_VOLUME=/data/hainan/mysql-data
LABEL_DATA_VOLUME=/data/hainan/label-data
POSTGRES_DATA_VOLUME=/data/hainan/postgres-data
POSTGRES_BACKUP_VOLUME=/data/hainan/postgres-backup
MINIO_DATA_VOLUME=/data/hainan/minio-data
REDIS_DATA_VOLUME=/data/hainan/redis-data

# ============ Docker Registry ============
DOCKER_REGISTRY_PREFIX=
IMAGE_TAG=latest

# ============ Training GPU ============
# TRAIN_DEVICE=cpu
TRAIN_DEVICE=[0]
TRAIN_BATCH=32

# ============ ML Backend 模型部署目录 ============
# Django 部署训练模型时复制到此路径（与 ml-backend 共享此目录）
# ml-backend 容器的 /data/models 也挂载到此目录
ML_BACKEND_MODEL_DIR=/data/hainan/mlbackend-models

# ============ ML Backend 服务地址 ============
# 部署训练模型时，Django 自动给项目创建/更新 ML Backend 连接所用的 URL。
# 必须是 app/rq 容器能访问到 ml-backend(9090) 的地址：用宿主机 IP，不能用 localhost。
# 详见 deploy/TROUBLESHOOTING.md 问题 11。
ML_BACKEND_URL=http://172.16.155.241:9090
